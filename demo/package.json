{
  "name": "llama-modes-demo",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src proxy.ts proxy.test.ts vite.config.ts eslint.config.js index.html",
    "format:check": "prettier --check src proxy.ts proxy.test.ts vite.config.ts eslint.config.js index.html"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
